rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {

      // Anyone can read orders — the stall display, admins, and the
      // customer status page all rely on open reads.
      allow read: if true;

      // A customer joining the queue may only create a fresh, valid
      // "queued" order with the required fields.
      allow create: if
        request.resource.data.keys().hasAll(['token', 'name', 'phone', 'status', 'createdAt']) &&
        request.resource.data.status == 'queued' &&
        request.resource.data.token is string && request.resource.data.token.size() > 0 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 7;

      // Only status + status-timestamp fields may ever be changed after
      // creation, and only into a recognised status value. This app has no
      // Firebase Auth for staff (the dashboards use a shared app password
      // instead), so these rules can't tell staff apart from anyone else —
      // see the README "Security notes" section before going to production.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'preparingAt', 'doneAt', 'completedAt']) &&
        request.resource.data.status in ['queued', 'accepted', 'preparing', 'done', 'completed'];

      allow delete: if false;
    }
  }
}
